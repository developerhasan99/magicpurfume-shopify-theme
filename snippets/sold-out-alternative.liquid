{% comment %}
  Sold out notice, plus a recommended alternative in place of the add to cart form.
  The alternative is the first in stock product from the custom.recommended_alternative
  metafield (list of products, tried in order). None in stock = notice only, no alternative.
  Tailwind here is precompiled: classes missing from tailwind-compiled.css are plain CSS below.

  Accepts:
  - product: {Object} the sold out product (required)

  Usage:
  {% render 'sold-out-alternative', product: product %}
{% endcomment %}
{%- liquid
  assign alt = false
  for p in product.metafields.custom.recommended_alternative.value
    if p.available and p.id != product.id
      assign alt = p
      break
    endif
  endfor
-%}
<style>
  .soa-notice {
    user-select: none;
  }
  .soa-notice__title {
    font-size: 16px;
  }
  @media (min-width: 750px) {
    .soa-notice__title {
      font-size: 19px;
    }
  }
  .soa-img {
    width: 5rem;
    height: 5rem;
  }
  .soa-size:has(:checked) {
    border-color: #000;
  }
  .soa-size:has(:focus-visible) {
    outline: 2px solid #000;
    outline-offset: 2px;
  }
</style>
<div class="soa-notice !mt-6 flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 bg-gray-100 text-gray-500 !py-3 px-3 text-center cursor-not-allowed" aria-disabled="true">
  <span class="soa-notice__title leading-snug font-semibold">{{ 'products.product.sold_out' | t }} – vorübergehend nicht auf Lager</span>
  {%- if alt -%}
    <span class="text-sm leading-snug">Dieser Artikel kann derzeit nicht bestellt werden. Probier unsere Alternative unten aus.</span>
  {%- else -%}
    <span class="text-sm leading-snug">Dieser Artikel kann derzeit nicht bestellt werden.</span>
  {%- endif -%}
</div>
{%- if alt -%}
  {%- liquid
    # Same convention as reactive-atc: prefer the 50 ml variant.
    assign alt_variant = alt.selected_or_first_available_variant
    for v in alt.variants
      if v.available and v.title contains '50'
        assign alt_variant = v
        break
      endif
    endfor
  -%}
  <div class="mt-4 rounded-xl border-2 border-solid border-gray-200 overflow-hidden bg-white" data-sold-out-alternative>
    <div class="bg-[#146b32] text-white font-semibold px-4 py-2">✓ Empfohlene Alternative</div>
    <div class="p-4">
      <a href="{{ alt.url }}" class="flex items-center gap-4 no-underline text-black">
        {%- if alt.featured_image -%}
          <img
            src="{{ alt.featured_image | image_url: width: 160 }}"
            alt="{{ alt.featured_image.alt | default: alt.title | escape }}"
            width="80"
            height="80"
            loading="lazy"
            class="soa-img object-contain shrink-0">
        {%- endif -%}
        <div>
          <h2 class="my-0 font-semibold text-lg tracking-tight">{{ alt.title }}</h2>
          {%- if alt.metafields.custom.inspiration != blank -%}
            <p class="text-base tracking-normal my-0 text-gray-700 leading-snug">Inspiriert von {{ alt.metafields.custom.inspiration.value.name }}</p>
          {%- endif -%}
          <p class="mt-1 mb-0 text-sm text-green-700 flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-green-600"></span>
            {{ 'products.product.inventory_in_stock' | t }}</p>
        </div>
      </a>
      {%- comment -%} No cta_product_from_submit_btn class: floating-atc would click this button under the sold out product's title. {%- endcomment -%}
      <product-form class="product-form !m-0" data-section-id="{{ section.id }}">
        {%- form 'product'
          , alt
          , class: 'form'
          , novalidate: 'novalidate'
          , data-type: 'add-to-cart-form' -%}
          {%- if alt.variants.size > 1 -%}
            <div class="flex justify-between items-center mb-3 !mt-6">
              <h2 class="m-0 text-sm md:text-base font-semibold">Größe auswählen:</h2>
            </div>
            <div
              class="flex gap-3 mb-3"
              role="radiogroup"
              aria-label="Größe auswählen">
              {%- for v in alt.variants -%}
                {%- if v.available -%}
                  {%- liquid
                    assign v_ml = 0
                    if v.title contains '100'
                      assign v_ml = 100
                    elsif v.title contains '50'
                      assign v_ml = 50
                    elsif v.title contains '30'
                      assign v_ml = 30
                    endif
                  -%}
                  <label class="soa-size flex-grow rounded-lg px-2 pt-4 pb-3 bg-white border-2 border-solid border-gray-200 cursor-pointer font-['Plus_Jakarta_Sans'] relative text-center">
                    <input
                      class="sr-only"
                      type="radio"
                      name="id"
                      value="{{ v.id }}"
                      {% if v.id == alt_variant.id %}
                      checked{% endif %}>
                    <div class="text-base font-semibold">{{ v.title }}</div>
                    {% if v.title contains '50' %}
                      <span class="text-xs italic text-white rounded absolute -top-2.5 left-1/2 [transform:translateX(-50%)] bg-[#c8202f] px-2 py-0.5">Beliebt</span>
                    {% endif %}
                    {% if v.title contains '100' %}
                      <span class="text-xs italic text-white rounded absolute -top-2.5 left-1/2 [transform:translateX(-50%)] bg-[#22613a] px-2 py-0.5">Bestseller</span>
                    {% endif %}
                    {% if v_ml > 0 %}
                      <div class="text-xs text-gray-500">{{ v.price | times: 1.0 | divided_by: v_ml | money }} / ml</div>
                    {% endif %}
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <input
              type="hidden"
              name="id"
              value="{{ alt_variant.id }}">
          {%- endif -%}
          <button
            type="submit"
            name="add"
            class="atc-button shimmer-btn flex flex-wrap items-center !mb-0 text-2xl !py-3 !px-2 rounded-lg button hover:bg-[#17803d] bg-[#146b32] transition-colors shadow-xl tracking-normal button--full-width button--primary"
            aria-label="{{ 'products.product.add_to_cart' | t }}: {{ alt.title | escape }}">
            <span>{{ 'products.product.add_to_cart' | t }}</span>
            <div class="ml-2 pl-2 border-0 border-l flex items-center border-solid border-gray-200/20">
              <div class="inline-block text-lg bg-[#0c5224] px-3 rounded">
                {%- for v in alt.variants -%}
                  {%- if v.available -%}
                    <span
                      data-price-for="{{ v.id }}"
                      {% if v.id != alt_variant.id %}
                      hidden{% endif %}>
                      {%- if v.compare_at_price > v.price -%}
                        <span class="line-through text-white/50 text-base">{{ v.compare_at_price | money }}</span>
                      {% endif -%}
                      {{ v.price | money -}}
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    </div>
  </div>
  <script>
    // Keeps the price in the button on the selected size.
    document.querySelectorAll('[data-sold-out-alternative] form').forEach((form) => {
      form.addEventListener('change', (e) => {
        if (e.target.name !== 'id') return;
        form.querySelectorAll('[data-price-for]').forEach((el) => (el.hidden = el.dataset.priceFor !== e.target.value));
      });
    });
  </script>
{%- endif -%}