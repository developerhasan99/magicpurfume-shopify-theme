{%- comment -%} MP LP · Flacons strip. Scrolling row of thumbnails; caption is a token-aware text setting. By default the row is filled by JS from the catalog, but adding image blocks below lets a merchant pin specific, manually-chosen images instead. {%- endcomment -%}
<div class="mp-lp">
<div class="mp-flacons" id="mp-flacons">
  <div class="mp-flacons__cap">{% render 'mp-lp-tokens', text: section.settings.caption, plain: true %}</div>
  {%- liquid
    assign has_images = false
    for block in section.blocks
      if block.settings.image != blank
        assign has_images = true
      endif
    endfor
  -%}
  {%- if has_images -%}
    <div class="mp-flacons__track" data-flacons data-manual aria-hidden="true">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <div class="mp-flacons__item" {{ block.shopify_attributes }}>
              <img src="{{ block.settings.image | image_url: width: 240 }}" width="120" height="120" alt="{{ block.settings.alt | escape }}" loading="lazy">
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="mp-flacons__track" data-flacons aria-hidden="true"></div>
  {%- endif -%}
</div>
</div>

{% schema %}
{
  "name": "MP LP · Flacons",
  "tag": "div",
  "class": "mp-lp-wrap",
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "A few of the {count} you can pick from", "info": "Tokens: {count}" }
  ],
  "max_blocks": 24,
  "blocks": [
    {
      "type": "flacon",
      "name": "Flacon image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [{ "name": "MP LP · Flacons" }]
}
{% endschema %}
